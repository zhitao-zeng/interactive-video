  "dialogue_changes": [
    {
      "index": 11,
      "shot_id": "E01-03-03",
      "before": "那你是不是特别会聊天？",
      "after": "你店里忙吗？",
      "reason": "把抽象的会聊天改为可以直接回答的日常问题"
    },
    {
      "index": 12,
      "shot_id": "E01-03-04",
      "before": "我平时对着书说，它们不太搭理我。",
      "after": "还行。不过今天有点紧张。",
      "reason": "承认眼前的紧张，给知意接话机会"
    },
    {
      "index": 13,
      "shot_id": "E01-03-05",
      "before": "怪不得你来了。",
      "after": "我也是。你来了就好点了。",
      "reason": "保留初见聊得来，也给后面的继续聊提供依据"
    },
    {
      "index": 18,
      "shot_id": "E01-04-05",
      "before": "记住了，随心所欲。",
      "after": "知意。记住了。",
      "reason": "保留认真记住名字，去掉重复包装的金句"
    },
    {
      "index": 23,
      "shot_id": "E01-05-05",
      "before": "先别谈生意。我是来约会的。",
      "after": "刚坐下，你就跟我谈生意啊？",
      "reason": "保留宋乔主动拉回约会话题；她已经坐下"
    },
    {
      "index": 30,
      "shot_id": "E01-07-03",
      "before": "以前觉得，事情做完再解释，也来得及。",
      "after": "以前一忙，就想着晚点再跟她说。",
      "reason": "保留延迟解释的旧问题，不新增失约原因"
    },
    {
      "index": 32,
      "shot_id": "E01-07-05",
      "before": "现在不这么想了。",
      "after": "后来她就不等了。",
      "reason": "保留后悔，不宣称自己已经改变"
    },
    {
      "index": 51,
      "shot_id": "E01-12-01",
      "before": "露台。我想补上两年前没来的那顿饭。",
      "after": "露台。两年前那顿饭，我还欠你个解释。",
      "reason": "保留旧失约与露台邀约，符合单独聊十分钟的规则"
    },
    {
      "index": 56,
      "shot_id": "E01-13-01",
      "before": "我约你在厨房。我还想接着聊。",
      "after": "厨房见？刚才还没聊完呢。",
      "reason": "把新邀约接回先前的相处"
    },
    {
      "index": 59,
      "shot_id": "E01-13-04",
      "before": "但刚才让我想坐你旁边的，是你。",
      "after": "刚才不是聊得挺好的吗？",
      "reason": "保留关注当下相处，不追问前任"
    },
    {
      "index": 62,
      "shot_id": "E01-14-02",
      "before": "我想一会儿。见面，也不代表答应什么。",
      "after": "我再想想。去了也只是聊聊。",
      "reason": "保留未选择与赴约不等于承诺"
    }
  ],
