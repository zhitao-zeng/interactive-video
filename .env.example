# Never commit credentials. Inject them at runtime.

# Leaderboard HTTP service. One novel job at a time leaves two-way video
# concurrency available inside the job on the 4-core/A100 submission host.
NOVEL_OUTPUT_ROOT=/output
NOVEL_UPLOAD_ROOT=/output/.uploads
NOVEL_JOB_ROOT=/output/.jobs
NOVEL_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc
NOVEL_PROVIDER=phanrouter
NOVEL_JOB_WORKERS=1
NOVEL_MAX_UPLOAD_BYTES=52428800

# Media provider: phanrouter
PHANROUTER_BASE_URL=https://cloud.phanthy.com/phanrouter
PHANROUTER_API_KEY=
PHANROUTER_IMAGE_MODEL=gpt-image-2
PHANROUTER_VIDEO_MODEL=sd2.5
NOVEL_INTRO_SECONDS=0
PHANROUTER_INLINE_REFERENCE_IMAGES=0
NOVEL_REUSE_EXISTING_ASSETS=0
NOVEL_REUSE_EXISTING_KEYFRAMES=0
NOVEL_FINAL_AUDIO_POLICY=native_dialogue
NOVEL_VIDEO_MAX_SECONDS=14

# Production planner: local command adapter (for example the bundled DeepSeek adapter).
NOVEL_PLANNER_BACKEND=command
NOVEL_PLANNER_COMMAND=python /app/scripts/deepseek_local_planner_command.py
NOVEL_PLANNER_MAX_REVISIONS=2
NOVEL_PLANNER_BEAT_MAX_RETRIES=1
NOVEL_PLANNING_TIMEOUT_SECONDS=600
DEEPSEEK_LOCAL_ROUTER_URL=http://127.0.0.1:4000
DEEPSEEK_LOCAL_ROUTER_KEY=
DEEPSEEK_LOCAL_MODEL=deepseek-local
DEEPSEEK_LOCAL_TIMEOUT=900
NOVEL_REQUEST_TIMEOUT=180

# Optional project-owned Qwen3.8 profile for both command planning and visual review.
# Start scripts/qwen38_vlm_service.sh on the host first. When the production app
# runs in a container, route this URL to the host explicitly instead of assuming
# the container's 127.0.0.1 is the host.
QWEN38_LOCAL_BASE_URL=http://127.0.0.1:18120/v1
QWEN38_LOCAL_MODEL=Qwen3.8-27B-Project
QWEN38_LOCAL_TIMEOUT=900
QWEN38_VLM_REVIEW_TIMEOUT=300
QWEN38_VLM_MIN_CONFIDENCE=0.72
# NOVEL_PLANNER_COMMAND=python /app/scripts/qwen38_local_planner_command.py
# NOVEL_DIRECTOR_REVIEW_COMMAND=python /app/scripts/qwen38_vlm_review_command.py

# Production evidence backend. ASR supplies subtitles and the three native
# dialogue hard checks; no TTS or reference-audio backend is used.
NOVEL_ASR_COMMAND=

NOVEL_ADMISSION_MODE=production
NOVEL_VIDEO_WORKERS=2
NOVEL_MAX_UNIT_ATTEMPTS=2
NOVEL_MAX_SUBTITLE_CPS=15
NOVEL_MIN_STYLE_CONSISTENCY=0.78
